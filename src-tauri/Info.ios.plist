<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Merged by Tauri into the iOS app Info.plist (see docs/IOS.md). -->
<plist version="1.0">
<dict>
  <key>NSCameraUsageDescription</key>
  <string>Earbud records video of your hands at the piano so you can review what you played.</string>
  <key>NSMicrophoneUsageDescription</key>
  <string>Earbud records the sound of your piano so it can save and transcribe your musical ideas.</string>
  <!-- Receiving recordings from the Earbud Apple Watch app over Bluetooth LE
       (plugins/tauri-plugin-watch-link). Asked only when "Receive recordings from
       Apple Watch" is switched on. The Wi-Fi receiver only accepts incoming
       connections, which needs no Local Network permission. -->
  <key>NSBluetoothAlwaysUsageDescription</key>
  <string>Earbud receives the recordings you make on your Apple Watch over Bluetooth, without needing Wi-Fi.</string>
  <!-- Allow the phone to be propped up in any orientation above the keys. -->
  <key>UISupportedInterfaceOrientations</key>
  <array>
    <string>UIInterfaceOrientationPortrait</string>
    <string>UIInterfaceOrientationLandscapeLeft</string>
    <string>UIInterfaceOrientationLandscapeRight</string>
  </array>
  <key>UISupportedInterfaceOrientations~ipad</key>
  <array>
    <string>UIInterfaceOrientationPortrait</string>
    <string>UIInterfaceOrientationPortraitUpsideDown</string>
    <string>UIInterfaceOrientationLandscapeLeft</string>
    <string>UIInterfaceOrientationLandscapeRight</string>
  </array>
  <key>ITSAppUsesNonExemptEncryption</key>
  <false/>
  <!-- iPad trackpad and mouse: UIKit's native indirect input instead of touch
       compatibility events, for the canvas's wheel scrolling (the fix used in
       Snorkle, laffan/snorkle commits 9cb5dd3 and 8c7eb87). -->
  <key>UIApplicationSupportsIndirectInputEvents</key>
  <true/>
  <!-- Tao's scene lifecycle, so the window is created with its scene's
       orientation. Without it a landscape iPad reported trackpad scrolls on
       the wrong axis (sideways for up and down). One window only; Tao (0.37.2
       and later) supplies TaoSceneDelegate. -->
  <key>UIApplicationSceneManifest</key>
  <dict>
    <key>UIApplicationSupportsMultipleScenes</key>
    <false/>
    <key>UISceneConfigurations</key>
    <dict>
      <key>UIWindowSceneSessionRoleApplication</key>
      <array>
        <dict>
          <key>UISceneConfigurationName</key>
          <string>Default Configuration</string>
          <key>UISceneDelegateClassName</key>
          <string>TaoSceneDelegate</string>
        </dict>
      </array>
    </dict>
  </dict>
</dict>
</plist>
