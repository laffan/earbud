{
  "name": "earbud",
  "private": true,
  "version": "0.1.0",
  "description": "Earbud: an offline-first musical sketchbook for pianists",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "copy-model": "node scripts/copy-model.mjs",
    "postinstall": "node scripts/copy-model.mjs",
    "tauri": "tauri"
  },
  "license": "MIT",
  "dependencies": {
    "@spotify/basic-pitch": "^1.0.1",
    "@tauri-apps/api": "^2.12.0",
    "@tauri-apps/plugin-dialog": "^2.8.0",
    "@tensorflow/tfjs": "^4.22.0",
    "@tonejs/midi": "^2.0.28",
    "tonal": "^6.5.1"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tauri-apps/cli": "^2.12.0",
    "@tsconfig/svelte": "^5.0.8",
    "svelte": "^5.56.3",
    "svelte-check": "^4.7.8",
    "typescript": "~6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "@spotify/basic-pitch": {
      "@tensorflow/tfjs": "$@tensorflow/tfjs"
    }
  }
}
